{
  "title": "Portfolio — App Overview",
  "tags": ["portfolio", "overview"],
  "editable": true,
  "liveNow": false,
  "preload": false,
  "cursorSync": "Off",
  "links": [],
  "variables": [],
  "timeSettings": {
    "autoRefresh": "30s",
    "autoRefreshIntervals": ["5s","10s","30s","1m","5m","15m","30m","1h","2h","1d"],
    "fiscalYearStartMonth": 0,
    "from": "now-24h",
    "hideTimepicker": false,
    "timezone": "browser",
    "to": "now"
  },
  "annotations": [],
  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "Page Views by Route",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${prometheus_ds_name}" },
                    "spec": {
                      "expr": "sum by (page) (increase(portfolio_page_views_total[5m]))",
                      "legendFormat": "{{page}}"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": { "mode": "palette-classic" },
                "custom": {
                  "axisBorderShow": false,
                  "axisCenteredZero": false,
                  "axisColorMode": "text",
                  "axisLabel": "",
                  "axisPlacement": "auto",
                  "barAlignment": 0,
                  "barWidthFactor": 0.6,
                  "drawStyle": "line",
                  "fillOpacity": 0,
                  "gradientMode": "none",
                  "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                  "insertNulls": false,
                  "lineInterpolation": "linear",
                  "lineWidth": 1,
                  "pointSize": 5,
                  "scaleDistribution": { "type": "linear" },
                  "showPoints": "auto",
                  "spanNulls": false,
                  "stacking": { "group": "A", "mode": "none" },
                  "thresholdsStyle": { "mode": "off" }
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 80 }]
                }
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [],
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": { "mode": "single", "sort": "none" }
            }
          }
        }
      }
    },
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "id": 2,
        "title": "Request Rate",
        "description": "Requests per second (proxy: session language counter fires on every server render)",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${prometheus_ds_name}" },
                    "spec": {
                      "expr": "sum(rate(portfolio_session_language_total[1m]))",
                      "legendFormat": "req/s"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": { "mode": "palette-classic" },
                "custom": {
                  "axisBorderShow": false,
                  "axisCenteredZero": false,
                  "axisColorMode": "text",
                  "axisLabel": "",
                  "axisPlacement": "auto",
                  "barAlignment": 0,
                  "barWidthFactor": 0.6,
                  "drawStyle": "line",
                  "fillOpacity": 0,
                  "gradientMode": "none",
                  "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                  "insertNulls": false,
                  "lineInterpolation": "linear",
                  "lineWidth": 1,
                  "pointSize": 5,
                  "scaleDistribution": { "type": "linear" },
                  "showPoints": "auto",
                  "spanNulls": false,
                  "stacking": { "group": "A", "mode": "none" },
                  "thresholdsStyle": { "mode": "off" }
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 80 }]
                },
                "unit": "reqps"
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [],
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": { "mode": "single", "sort": "none" }
            }
          }
        }
      }
    },
    "panel-3": {
      "kind": "Panel",
      "spec": {
        "id": 3,
        "title": "Log Volume by Severity",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "loki",
                    "version": "v0",
                    "datasource": { "name": "${loki_ds_name}" },
                    "spec": {
                      "expr": "sum by (severity) (count_over_time({service_name=\"portfolio\"}[1m]))",
                      "legendFormat": "{{severity}}"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": { "mode": "palette-classic" },
                "custom": {
                  "axisBorderShow": false,
                  "axisCenteredZero": false,
                  "axisColorMode": "text",
                  "axisLabel": "",
                  "axisPlacement": "auto",
                  "barAlignment": 0,
                  "barWidthFactor": 0.6,
                  "drawStyle": "line",
                  "fillOpacity": 0,
                  "gradientMode": "none",
                  "hideFrom": { "legend": false, "tooltip": false, "viz": false },
                  "insertNulls": false,
                  "lineInterpolation": "linear",
                  "lineWidth": 1,
                  "pointSize": 5,
                  "scaleDistribution": { "type": "linear" },
                  "showPoints": "auto",
                  "spanNulls": false,
                  "stacking": { "group": "A", "mode": "none" },
                  "thresholdsStyle": { "mode": "off" }
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 80 }]
                },
                "unit": "short"
              },
              "overrides": []
            },
            "options": {
              "legend": {
                "calcs": [],
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": true
              },
              "tooltip": { "mode": "single", "sort": "none" }
            }
          }
        }
      }
    },
    "panel-4": {
      "kind": "Panel",
      "spec": {
        "id": 4,
        "title": "Error & Warn Logs",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "loki",
                    "version": "v0",
                    "datasource": { "name": "${loki_ds_name}" },
                    "spec": {
                      "expr": "{service_name=\"portfolio\", severity=~\"WARN|ERROR\"}"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "logs",
          "spec": {
            "fieldConfig": { "defaults": {}, "overrides": [] },
            "options": {
              "dedupStrategy": "none",
              "enableLogDetails": true,
              "prettifyLogMessage": true,
              "showLevel": true,
              "showTime": false,
              "sortOrder": "Descending",
              "wrapLogMessage": false
            }
          }
        }
      }
    },
    "panel-5": {
      "kind": "Panel",
      "spec": {
        "id": 5,
        "title": "Traces",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "tempo",
                    "version": "v0",
                    "datasource": { "name": "${tempo_ds_name}" },
                    "spec": {
                      "limit": 20,
                      "query": "{resource.service.name = \"portfolio\"}",
                      "queryType": "traceql"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "traces",
          "spec": {
            "fieldConfig": { "defaults": {}, "overrides": [] },
            "options": {}
          }
        }
      }
    },
    "panel-6": {
      "kind": "Panel",
      "spec": {
        "id": 6,
        "title": "Sessions by Language",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${prometheus_ds_name}" },
                    "spec": {
                      "expr": "sum by (locale) (increase(portfolio_session_language_total[$__range]))",
                      "instant": true,
                      "legendFormat": "{{locale}}"
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "piechart",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": { "mode": "palette-classic" },
                "custom": {
                  "hideFrom": { "legend": false, "tooltip": false, "viz": false }
                }
              },
              "overrides": []
            },
            "options": {
              "displayLabels": ["name", "percent"],
              "legend": {
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": true
              },
              "pieType": "pie",
              "reduceOptions": {
                "calcs": ["lastNotNull"],
                "fields": "",
                "values": false
              },
              "tooltip": { "mode": "single", "sort": "none" }
            }
          }
        }
      }
    },
    "panel-7": {
      "kind": "Panel",
      "spec": {
        "id": 7,
        "title": "Page Views by Country",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${prometheus_ds_name}" },
                    "spec": {
                      "expr": "sum by (country) (last_over_time(portfolio_page_views_total{country!=\"\"}[$__range]))",
                      "format": "table",
                      "instant": true
                    }
                  }
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "geomap",
          "spec": {
            "fieldConfig": { "defaults": {}, "overrides": [] },
            "options": {
              "basemap": { "name": "Basemap", "type": "default" },
              "controls": {
                "mouseWheelZoom": true,
                "showAttribution": true,
                "showScale": false,
                "showZoom": true
              },
              "layers": [
                {
                  "config": {
                    "style": {
                      "color": { "fixed": "red" },
                      "opacity": 0.8,
                      "size": { "field": "Value", "fixed": 10, "max": 30, "min": 8 }
                    }
                  },
                  "location": {
                    "gazetteer": "public/gazetteer/countries.json",
                    "lookup": "country",
                    "mode": "lookup"
                  },
                  "name": "Page Views",
                  "tooltip": true,
                  "type": "markers"
                }
              ],
              "tooltip": { "mode": "details" },
              "view": { "id": "zero", "lat": 30, "lon": 0, "zoom": 1 }
            }
          }
        }
      }
    },
