            "fieldConfig": {
              "defaults": {
                "color": { "mode": "palette-classic" },
                "custom": {
                  "hideFrom": { "legend": false, "tooltip": false, "viz": false }
                }
              },
              "overrides": []
            },
            "options": {
              "displayLabels": ["name", "percent"],
              "legend": {
                "displayMode": "list",
                "placement": "bottom",
                "showLegend": true
              },
              "pieType": "pie",
              "reduceOptions": {
                "calcs": ["lastNotNull"],
